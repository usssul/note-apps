# MongoDB 配置（使用线上服务）
MONGODB_URI=mongodb://admin:password@your-mongodb-host:27017/notemark?authSource=admin

# MinIO 配置（使用线上服务）
MINIO_ENDPOINT=your-minio-host
MINIO_PORT=9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=xhs
MINIO_URL=http://your-minio-host:9000/xhs/

# MinIO 存储桶配置
MINIO_BUCKET_AVATAR=avatar
MINIO_BUCKET_MY903_VIDEO=xhs-video

# 应用配置
NODE_ENV=production
PORT=6090

# JWT 认证配置
JWT_SECRET=sadasd4333ddd
JWT_EXPIRES_IN=24h

# MySQL 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=note-mark
DB_SYNC=false
DB_LOGGING=false

# my903爬虫配置
# 要抓取的栏目ID，逗号分隔（7=专业推介, 8=豁达推介, 9=派台歌）
MY903_FETCH_COLUMNS=9 #7,8,9
# 每次每个栏目抓取的最大条数
MY903_FETCH_LIMIT=10

# HTTP 代理配置（可选，用于访问外部 API）
# 如果需要代理访问 881903.com 等外部网站，请取消下面的注释
HTTP_PROXY=http://host.docker.internal:7890
HTTPS_PROXY=http://host.docker.internal:7890
